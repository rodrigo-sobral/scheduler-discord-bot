# Discord Bot Token
# Get this from: https://discord.com/developers/applications
# 1. Create an application
# 2. Go to Bot section and copy the token
BOT_TOKEN=your_bot_token_here

# Database URL (Prisma 7)
DATABASE_URL=your_database_url_here

# Optional: Bot owner ID (for future admin commands)
# OWNER_ID=your_discord_user_id

# Optional: Environment (development, testing, production)
ENVIRONMENT=your_environment_here

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=your_log_level_here
